<h1>Post a New Link</h1>

<%= form_with(model: @link, local: true) do |f| %>
  <% if @link.errors.any? %>
    <div class="errors">
      <h3><%= pluralize(@link.errors.count, "error") %> prevented this link from being saved:</h3>
      <ul>
        <% @link.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, placeholder: "Link title" %>
  </div>

  <div class="field">
    <%= f.label :url %>
    <%= f.url_field :url, placeholder: "https://example.com" %>
  </div>

  <%= f.submit "Post Link" %>
<% end %>

<%= link_to "← Cancel", links_path %>