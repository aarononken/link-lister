<h1>Link Lister</h1>

<% if user_signed_in? %>
  <p><%= link_to 'Post a New Link', new_link_path, class: 'button' %></p>
<% end %>

<div class="links">
  <% @links.each do |link| %>
    <div class="link">
      <div class="score"><%= link.cached_votes_score %></div>
      <div class="content">
        <h3><%= link_to link.title, link.url, target: "_blank", rel: "noopener" %></h3>
        <p class="meta">
          Posted by <%= link_to link.user.username, user_path(link.user) %>
          <%= time_ago_in_words(link.created_at) %> ago
          | <%= link_to "#{link.comments.count} comments", link_path(link) %>
        </p>
        <% if user_signed_in? && current_user != link.user %>
          <div class="actions">
            <%= button_to "▲ Upvote", upvote_link_path(link) %>
            <%= button_to "▼ Downvote", downvote_link_path(link) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>