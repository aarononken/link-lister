<h2>Links</h2>

<% @links.each do |link| %>
  <div>
    <strong><%= link.cached_votes_score %></strong>
    <%= link_to link.title, link.url, target: "_blank", rel: "noopener" %>
    — submitted by <%= link_to link.user.username, user_path(link.user) %>,
    <%= time_ago_in_words(link.created_at) %> ago

    <% if user_signed_in? && current_user != link.user %>
      <%= button_to "▲", like_link_path(link), method: :put %>
      <%= button_to "▼", dislike_link_path(link), method: :put %>
    <% end %>

    | <%= link_to "Details", link_path(link) %>
  </div>
<% end %>

<br>

<% if user_signed_in? %>
  <%= link_to "Submit a link", new_link_path %>
<% end %>
